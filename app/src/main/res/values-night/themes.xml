<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UserApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cor primária no Dark Mode -->
        <item name="colorPrimary">@color/yellow_500</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Fundo das telas fica escuro -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>

        <item name="colorSurfaceContainerLow">@color/surface_container_dark</item>
    </style>

    <style name="ThemeOverlay.UserApp.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
    </style>
</resources>