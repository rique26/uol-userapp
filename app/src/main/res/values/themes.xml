<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UserApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cor primária -->
        <item name="colorPrimary">@color/yellow_500</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Superfície e fundo das telas -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <item name="colorSurfaceContainerLow">@color/surface_container_light</item>
    </style>

    <style name="ThemeOverlay.UserApp.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="titleTextColor">@color/black</item>
        <item name="subtitleTextColor">@color/black</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
    </style>

    <style name="Theme.UserApp" parent="Base.Theme.UserApp" />
</resources>